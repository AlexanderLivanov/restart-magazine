import React from "react";
import HTMLFlipBook from "react-pageflip";
import "./App.css";

// Страницы журнала. Пути относительные — сборка работает и из подпапки XAMPP.
const PAGE_URLS = ["page0.html", "page1.php", "page2.html", "page5.html", "page6.html", "page7.html"];
const CUSTOM_CURSOR = false;

// Рендерит HTML страницы в Shadow DOM: её <style> (*, body, html …)
// больше не протекают в приложение и в соседние страницы.
function ShadowHtml({ html }) {
  const hostRef = React.useRef(null);

  React.useLayoutEffect(() => {
    const host = hostRef.current;
    const root = host.shadowRoot || host.attachShadow({ mode: "open" });
    const doc = new DOMParser().parseFromString(html, "text/html");

    const css = [...doc.querySelectorAll("style")]
      .map((s) => s.textContent)
      .join("\n")
      .replace(/(^|[\s,}])(?:html|body)(?=[\s,{.:#[])/g, "$1:host");

    doc.querySelectorAll("style, script").forEach((n) => n.remove());

    root.innerHTML =
      `<style>:host{display:block;width:100%;height:100%;overflow:hidden}${css}</style>` +
      doc.body.innerHTML;
  }, [html]);

  return <div ref={hostRef} className="page-html" />;
}

const PageCover = React.forwardRef((props, ref) => (
  <div className="page page-cover" ref={ref} data-density="soft">
    <div className="page-content">
      <h2>{props.children}</h2>
    </div>
  </div>
));

const Page = React.forwardRef((props, ref) => (
  <div className="page" ref={ref}>
    <div className="page-content">{props.children}</div>
  </div>
));

async function loadPage(url) {
  const res = await fetch(`${process.env.PUBLIC_URL}/${url}`);
  const html = res.ok ? await res.text() : "";
  // dev-сервер CRA на несуществующий файл отдаёт index.html самого приложения
  return html.includes('id="root"') ? "" : html;
}

class DemoBook extends React.Component {
  state = { pages: null, error: null };
  flipBook = React.createRef();
  cursor = null;

  flip = (dir) => {
    const pf = this.flipBook.current?.pageFlip();
    if (pf) dir > 0 ? pf.flipNext() : pf.flipPrev();
  };

  handleKeyDown = (e) => {
    if (e.key === "ArrowRight") this.flip(1);
    else if (e.key === "ArrowLeft") this.flip(-1);
  };

  handleMouseMove = (e) => {
    this.cursor.style.left = e.clientX + "px";
    this.cursor.style.top = e.clientY + "px";
  };
  handleMouseDown = () => this.cursor.classList.add("pressed");
  handleMouseUp = () => this.cursor.classList.remove("pressed");

  componentDidMount() {
    this.alive = true;
    window.addEventListener("keydown", this.handleKeyDown);

    Promise.all(PAGE_URLS.map(loadPage))
      .then((pages) => this.alive && this.setState({ pages }))
      .catch((error) => {
        console.error("Ошибка загрузки страниц:", error);
        if (this.alive) this.setState({ error });
      });

    if (CUSTOM_CURSOR) {
      this.cursor = document.createElement("div");
      this.cursor.id = "custom-cursor";
      document.body.appendChild(this.cursor);
      window.addEventListener("mousemove", this.handleMouseMove);
      window.addEventListener("mousedown", this.handleMouseDown);
      window.addEventListener("mouseup", this.handleMouseUp);
    }
  }

  componentWillUnmount() {
    this.alive = false;
    window.removeEventListener("keydown", this.handleKeyDown);
    if (this.cursor) {
      window.removeEventListener("mousemove", this.handleMouseMove);
      window.removeEventListener("mousedown", this.handleMouseDown);
      window.removeEventListener("mouseup", this.handleMouseUp);
      this.cursor.remove();
      this.cursor = null;
    }
  }

  render() {
    const { pages, error } = this.state;

    if (error) return <p className="loading">Не удалось загрузить журнал</p>;
    if (!pages) return <p className="loading">Загрузка страниц</p>;

    return (
      <div className="flipbook-container">
        <HTMLFlipBook
          width={595}
          height={842}
          size="stretch"
          minWidth={280}
          maxWidth={595}
          minHeight={396}
          maxHeight={842}
          showCover={false}
          maxShadowOpacity={1}
          flippingTime={700}
          mobileScrollSupport={false}
          ref={this.flipBook}
        >
          <PageCover />

          {pages.map((html, i) => (
            <Page key={PAGE_URLS[i]}>
              <ShadowHtml html={html} />
            </Page>
          ))}

          <PageCover>THE END</PageCover>
        </HTMLFlipBook>
      </div>
    );
  }
}

export default DemoBook;
